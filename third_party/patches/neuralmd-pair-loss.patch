+def save_periodic_model(epoch):
+    if args.output_model_dir == "":
+        return
+    output_model_path = os.path.join(
+        args.output_model_dir, "model_epoch_{:03d}.pth".format(epoch)
+    )
+    torch.save({"binding_model": binding_model.state_dict()}, output_model_path)
+    print("save periodic model", output_model_path)
+
+
+def _parameter_gradient_norm(loss, retain_graph):
+    gradients = torch.autograd.grad(
+        loss,
+        tuple(binding_model.parameters()),
+        retain_graph=retain_graph,
+        allow_unused=True,
+    )
+    squared_norm = loss.new_zeros(())
+    for gradient in gradients:
+        if gradient is not None:
+            squared_norm = squared_norm + gradient.detach().pow(2).sum()
+    return float(torch.sqrt(squared_norm).cpu().item())
+
+
+def preserve_skipped_loader_rng(loader):
+    """Match DataLoader iterator seeding without reading held-out samples."""
+    torch.empty((), dtype=torch.int64).random_(generator=loader.generator).item()
+
+
+def calibrate_pair_loss(loader):
+    binding_model.train()
+    position_grad_norms, pair_grad_norms = [], []
+    for batch_index, batch in enumerate(loader):
+        if batch_index >= args.calibration_batches:
+            break
+        batch = batch.to(device)
+        end_traj_idx = random.randint(1, 99)
+        if args.NeuralMD_Binding_start_with_first_frame:
+            start_traj_idx = 0
+        else:
+            start_traj_idx = max(
+                0, end_traj_idx - args.NeuralMD_Binding_frame_num
+            )
+        step_size = args.NeuralMD_step_size / args.NeuralMD_scaling
+        traj_idx_tensor = torch.tensor(
+            np.arange(start_traj_idx, end_traj_idx + 1),
+            dtype=torch.float32,
+            device=device,
+        ) / args.NeuralMD_scaling
+        traj_idx_tensor = traj_idx_tensor - traj_idx_tensor[0]
+        ligand_pos_init = batch.ligand_trajectory_pos[:, start_traj_idx, :].clone()
+        velocity_init = (
+            batch.ligand_trajectory_pos[:, start_traj_idx + 1, :]
+            - ligand_pos_init
+        )
+        condition = (
+            batch.ligand_x,
+            batch.batch_ligand,
+            batch.ligand_mass,
+            batch.protein_pos[batch.mask_n],
+            batch.protein_pos[batch.mask_ca],
+            batch.protein_pos[batch.mask_c],
+            batch.protein_backbone_residue,
+            batch.batch_residue,
+        )
+        if args.use_MLP_velocity:
+            _, velocity_init = binding_model.velocity_model(
+                z=condition[0], pos=velocity_init, batch=condition[1]
+            )
+        _, output_pos_pred = odeint(
+            binding_model,
+            (velocity_init, ligand_pos_init),
+            traj_idx_tensor,
+            condition=condition,
+            method=args.ODE_method,
+            options={"step_size": step_size},
+        )
+        target = batch.ligand_trajectory_pos[
+            :, start_traj_idx + 1 : end_traj_idx + 1, :
+        ].transpose(0, 1)
+        prediction = output_pos_pred[1:]
+        loss_pos = criterion(target, prediction)
+        loss_pair = pair_distance_smooth_l1(
+            prediction,
+            target,
+            batch.batch_ligand,
+            beta=args.pair_loss_beta,
+        )
+        position_grad_norms.append(
+            _parameter_gradient_norm(args.loss_pos_coefficient * loss_pos, True)
+        )
+        pair_grad_norms.append(_parameter_gradient_norm(loss_pair, False))
+        print(
+            "calibration batch {} position_grad_norm {:.8g} pair_grad_norm {:.8g}".format(
+                batch_index + 1,
+                position_grad_norms[-1],
+                pair_grad_norms[-1],
+            )
+        )
+    if len(position_grad_norms) != args.calibration_batches:
+        raise RuntimeError("calibration loader ended before the requested batch count")
+    coefficient = calibrated_auxiliary_weight(
+        position_grad_norms,
+        pair_grad_norms,
+        target_fraction=args.calibration_target_fraction,
+    )
+    report = {
+        "status": "training-only gradient calibration; not model selection",
+        "calibration_batches": args.calibration_batches,
+        "target_fraction": args.calibration_target_fraction,
+        "pair_loss_beta": args.pair_loss_beta,
+        "position_grad_norms": position_grad_norms,
+        "pair_grad_norms": pair_grad_norms,
+        "ratios": [
+            position / max(pair, 1e-12)
+            for position, pair in zip(position_grad_norms, pair_grad_norms)
+        ],
+        "pair_loss_coefficient": coefficient,
+    }
+    output_parent = os.path.dirname(args.calibration_output)
+    if output_parent:
+        os.makedirs(output_parent, exist_ok=True)
+    with open(args.calibration_output, "w", encoding="utf-8") as stream:
+        json.dump(report, stream, indent=2)
+    print("calibrated pair loss coefficient", coefficient)
+    return report
+
